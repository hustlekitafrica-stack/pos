{
  "expo": {
    "name": "Bar POS",
    "slug": "kogelo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "barpos",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.barpos.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "abiFilters": ["arm64-v8a", "armeabi-v7a"],
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so", "**/libfbjni.so"]
            }
          }
        }
      ],
      "./plugins/withBuildFixes"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Bar POS",
      "shortName": "Bar POS",
      "description": "Bar & Restaurant Point of Sale System",
      "themeColor": "#1a1a2e",
      "backgroundColor": "#0f172a",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "13a82b9e-ba5b-4f9b-960a-4c7551f274ad"
      }
    },
    "owner": "kogelos-team"
  }
}
